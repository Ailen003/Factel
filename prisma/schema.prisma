generator client {
  provider = "prisma-client"
  output   = "../lib/persistence/generated"
}

datasource db {
  provider = "postgresql"
}

// This schema is the physical starting point for docs/data-model.md. Invariants
// that PostgreSQL/Prisma cannot express alone are listed in prisma/README.md
// and must be added to the first reviewed migration or enforced transactionally.

enum AppRole {
  trial_user     @map("TRIAL_USER")
  platform_admin @map("PLATFORM_ADMIN")
}

enum AdminProfile {
  owner    @map("OWNER")
  operator @map("OPERATOR")
}

enum AdminProfileMutationKind {
  promote_operator       @map("PROMOTE_OPERATOR")
  demote_operator        @map("DEMOTE_OPERATOR")
  bootstrap_owner        @map("BOOTSTRAP_OWNER")
  bootstrap_operator     @map("BOOTSTRAP_OPERATOR")
  transfer_promote_owner @map("TRANSFER_PROMOTE_OWNER")
  transfer_demote_owner  @map("TRANSFER_DEMOTE_OWNER")
}

enum AdminSecurityOperationKind {
  operator_mfa_recovery       @map("OPERATOR_MFA_RECOVERY")
  owner_mfa_break_glass       @map("OWNER_MFA_BREAK_GLASS")
  ownership_transfer_initiate @map("OWNERSHIP_TRANSFER_INITIATE")
  ownership_transfer_cancel   @map("OWNERSHIP_TRANSFER_CANCEL")
  ownership_transfer_decline  @map("OWNERSHIP_TRANSFER_DECLINE")
  ownership_transfer_accept   @map("OWNERSHIP_TRANSFER_ACCEPT")
  ownership_transfer_expire   @map("OWNERSHIP_TRANSFER_EXPIRE")
}

enum AdminSecurityOperationStatus {
  pending   @map("PENDING")
  succeeded @map("SUCCEEDED")
  denied    @map("DENIED")
  failed    @map("FAILED")
}

enum MfaRecoveryReason {
  lost_all_factors     @map("LOST_ALL_FACTORS")
  lost_device          @map("LOST_DEVICE")
  suspected_compromise @map("SUSPECTED_COMPROMISE")
  operational_recovery @map("OPERATIONAL_RECOVERY")
  other                @map("OTHER")
}

enum OwnershipTransferStatus {
  pending     @map("PENDING")
  accepted    @map("ACCEPTED")
  declined    @map("DECLINED")
  cancelled   @map("CANCELLED")
  expired     @map("EXPIRED")
  invalidated @map("INVALIDATED")
}

enum UserStatus {
  active    @map("ACTIVE")
  suspended @map("SUSPENDED")
  deleting  @map("DELETING")
  deleted   @map("DELETED")
}

enum AppLocale {
  en @map("EN")
  es @map("ES")
}

enum TemporaryPasswordPurpose {
  activation @map("ACTIVATION")
  recovery   @map("RECOVERY")
}

enum TemporaryCredentialReason {
  expired_credential   @map("EXPIRED_CREDENTIAL")
  forgotten_password   @map("FORGOTTEN_PASSWORD")
  suspected_compromise @map("SUSPECTED_COMPROMISE")
  failure_recovery     @map("FAILURE_RECOVERY")
  other                @map("OTHER")
}

enum TemporaryCredentialIssuanceStatus {
  prepared   @map("PREPARED")
  issued     @map("ISSUED")
  superseded @map("SUPERSEDED")
  failed     @map("FAILED")
}

enum TemporaryCredentialDeliveryChannel {
  in_person      @map("IN_PERSON")
  phone          @map("PHONE")
  secure_message @map("SECURE_MESSAGE")
  other          @map("OTHER")
}

enum WorkspaceLifecycle {
  ACTIVE
  DELETING
  DELETED
}

enum ServiceType {
  INSTALLATION
  REPAIR
  MAINTENANCE
  INSPECTION
  OTHER
}

enum RequestPriority {
  LOW
  NORMAL
  HIGH
}

enum ServiceRequestStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

enum ConversationSourceType {
  MICROPHONE
  UPLOAD
}

enum ConversationStatus {
  DRAFT
  AUDIO_READY
  QUEUED
  TRANSCRIBING
  DIARIZING
  TRANSCRIBED
  EXTRACTING
  VALIDATING
  NEEDS_REVIEW
  READY
  RECORD_PLAN_PENDING
  COMPLETED
  FAILED
  QUOTA_BLOCKED
  CANCELLED
}

enum DeletionState {
  ACTIVE
  DELETE_REQUESTED
  DELETING
  DELETED
  FAILED
}

enum ArtifactVerificationState {
  PENDING
  UPLOADED
  VERIFIED
  REJECTED
  DELETED
}

enum UploadGrantStatus {
  ISSUED
  COMPLETED
  CONSUMED
  EXPIRED
  REVOKED
}

enum DiarizationStatus {
  PENDING
  AVAILABLE
  UNAVAILABLE
  FAILED
}

enum ProposalAuthorKind {
  EXTRACTION
  HUMAN
}

enum ProposalRevisionStatus {
  CANDIDATE
  READY
  SUPERSEDED
  INVALIDATED
}

enum ProposalFieldTarget {
  CLIENT
  REQUEST
}

enum ProposalFieldProvenance {
  EXTRACTED
  MANUAL
  DEFAULT
}

enum FindingSeverity {
  BLOCKING
  WARNING
  INFO
}

enum FindingCode {
  MISSING_REQUIRED
  INVALID_FORMAT
  NONEXISTENT_EVIDENCE
  AMBIGUITY
  CONTRADICTION
  LOW_CONFIDENCE
  SENSITIVE_DATA_OMITTED
}

enum ProcessingRunStatus {
  ACCEPTED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  QUOTA_BLOCKED
}

enum ProcessingStage {
  QUEUED
  TRANSCRIBING
  DIARIZING
  EXTRACTING
  VALIDATING
  PUBLISHING
}

enum CheckpointOutcome {
  PENDING
  SUCCEEDED
  RETRYABLE_FAILURE
  TERMINAL_FAILURE
  SKIPPED
}

enum ProviderInvocationStatus {
  PENDING
  SUCCEEDED
  FAILED
  RATE_LIMITED
  CANCELLED
}

enum CreditEntryKind {
  GRANT
  RESERVE
  CONSUME
  RESTORE
  ADJUSTMENT
}

enum CreditReservationStatus {
  ACTIVE
  CONSUMED
  RESTORED
}

enum RecordPlanKind {
  MANUAL_CLIENT_CREATE
  MANUAL_REQUEST_CREATE
  CONVERSATION_BATCH_CREATE
}

enum RecordPlanStatus {
  PREPARED
  APPROVED
  DENIED
  COMMITTED
  INVALIDATED
  EXPIRED
}

enum RecordApprovalDecision {
  APPROVED
  DENIED
}

enum RecordOrigin {
  MANUAL
  CONVERSATION
}

enum OperationOutcome {
  PENDING
  SUCCEEDED
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

enum AssistantMessageRole {
  USER
  ASSISTANT
  TOOL
  SYSTEM
}

enum AssistantMessageStatus {
  PENDING
  STREAMING
  COMPLETED
  FAILED
  CANCELLED
}

enum ToolInvocationStatus {
  PENDING
  AWAITING_APPROVAL
  SUCCEEDED
  DENIED
  FAILED
  CANCELLED
}

enum AuditOutcome {
  ALLOWED
  DENIED
  SUCCEEDED
  FAILED
}

enum CleanupTaskStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PolicyStatus {
  ACTIVE
  DISABLED
  ARCHIVED
}

enum CircuitState {
  CLOSED
  OPEN
  HALF_OPEN
}

// Better Auth-compatible identity records. Auth implementation is intentionally
// deferred; credentials stay in Account.password as a provider-owned hash only.
model User {
  id                               String                        @id @default(cuid())
  email                            String                        @unique @db.VarChar(320)
  emailVerified                    Boolean                       @default(false) @map("email_verified")
  name                             String                        @db.VarChar(201)
  image                            String?
  role                             AppRole                       @default(trial_user)
  adminProfile                     AdminProfile?                 @map("admin_profile")
  adminProfileVersion              Int                           @default(0) @map("admin_profile_version")
  status                           UserStatus                    @default(active)
  locale                           AppLocale                     @default(en)
  temporaryPasswordChangeRequired  Boolean                       @default(false) @map("temporary_password_change_required")
  temporaryPasswordExpiresAt       DateTime?                     @map("temporary_password_expires_at")
  temporaryPasswordPurpose         TemporaryPasswordPurpose?     @map("temporary_password_purpose")
  temporaryCredentialVersion       Int                           @default(0) @map("temporary_credential_version")
  trialActivatedAt                 DateTime?                     @map("trial_activated_at")
  trialExpiresAt                   DateTime?                     @map("trial_expires_at")
  initialCreditAllocation          Int                           @default(10) @map("initial_credit_allocation")
  twoFactorEnabled                 Boolean                       @default(false) @map("two_factor_enabled")
  banned                           Boolean                       @default(false)
  banReason                        String?                       @map("ban_reason")
  banExpires                       DateTime?                     @map("ban_expires")
  createdAt                        DateTime                      @default(now()) @map("created_at")
  updatedAt                        DateTime                      @updatedAt @map("updated_at")
  sessions                         Session[]
  accounts                         Account[]
  twoFactor                        TwoFactor?
  workspace                        Workspace?
  createdClients                   Client[]                      @relation("ClientCreatedBy")
  updatedClients                   Client[]                      @relation("ClientUpdatedBy")
  createdRequests                  ServiceRequest[]              @relation("RequestCreatedBy")
  updatedRequests                  ServiceRequest[]              @relation("RequestUpdatedBy")
  humanProposalRevisions           ProposalRevision[]            @relation("ProposalHumanAuthor")
  readyProposalRevisions           ProposalRevision[]            @relation("ProposalReadyBy")
  createdRecordPlans               RecordPlan[]                  @relation("RecordPlanCreatedBy")
  approvals                        RecordApproval[]
  operationReceipts                OperationReceipt[]            @relation("OperationActor")
  assistantThreads                 AssistantThread[]
  assistantMessages                AssistantMessage[]            @relation("AssistantMessageAuthor")
  auditEvents                      AuditEvent[]                  @relation("AuditActor")
  cleanupTasks                     CleanupTask[]                 @relation("CleanupRequestedBy")
  updatedPlatformSettings          PlatformSettings[]            @relation("PlatformSettingsUpdatedBy")
  temporaryCredentialTargets       TemporaryCredentialIssuance[] @relation("TemporaryCredentialTarget")
  initiatedTemporaryCredentials    TemporaryCredentialIssuance[] @relation("TemporaryCredentialInitiator")
  deliveredTemporaryCredentials    TemporaryCredentialIssuance[] @relation("TemporaryCredentialDeliverer")
  adminProfileMutationTargets      AdminProfileMutation[]        @relation("AdminProfileMutationTarget")
  initiatedAdminProfileMutations   AdminProfileMutation[]        @relation("AdminProfileMutationInitiator")
  initiatedAdminSecurityOperations AdminSecurityOperation[]      @relation("AdminSecurityOperationActor")
  targetedAdminSecurityOperations  AdminSecurityOperation[]      @relation("AdminSecurityOperationTarget")
  ownedOwnershipTransfers          OwnershipTransfer[]           @relation("OwnershipTransferOwner")
  targetedOwnershipTransfers       OwnershipTransfer[]           @relation("OwnershipTransferTarget")

  @@index([role, status])
  @@index([adminProfile, status])
  @@index([temporaryPasswordChangeRequired, temporaryPasswordExpiresAt], map: "users_temporary_password_change_required_temporary_password_exp")
  @@index([trialExpiresAt])
  @@map("users")
}

model TwoFactor {
  id                      String    @id @default(cuid())
  secret                  String
  backupCodes             String    @map("backup_codes")
  userId                  String    @unique @map("user_id")
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until")
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@map("two_factor")
}

model AdminSecurityOperation {
  id                     String                       @id @default(cuid())
  operationId            String                       @unique @map("operation_id") @db.Uuid
  kind                   AdminSecurityOperationKind
  parameterFingerprint   String                       @map("parameter_fingerprint") @db.VarChar(64)
  actorUserId            String?                      @map("actor_user_id")
  targetUserId           String?                      @map("target_user_id")
  ownershipTransferId    String?                      @map("ownership_transfer_id")
  recoveryReason         MfaRecoveryReason?           @map("recovery_reason")
  operationalReference   String?                      @map("operational_reference") @db.VarChar(120)
  expectedActorVersion   Int?                         @map("expected_actor_version")
  expectedTargetVersion  Int?                         @map("expected_target_version")
  committedActorVersion  Int?                         @map("committed_actor_version")
  committedTargetVersion Int?                         @map("committed_target_version")
  status                 AdminSecurityOperationStatus @default(pending)
  safeFailureCode        String?                      @map("safe_failure_code") @db.VarChar(64)
  revokedActorSessions   Int                          @default(0) @map("revoked_actor_sessions")
  revokedTargetSessions  Int                          @default(0) @map("revoked_target_sessions")
  createdAt              DateTime                     @default(now()) @map("created_at")
  completedAt            DateTime?                    @map("completed_at")
  actor                  User?                        @relation("AdminSecurityOperationActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  target                 User?                        @relation("AdminSecurityOperationTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  ownershipTransfer      OwnershipTransfer?           @relation(fields: [ownershipTransferId], references: [id], onDelete: Restrict)

  @@index([targetUserId, kind, createdAt], map: "admin_security_operations_target_kind_created_idx")
  @@index([actorUserId, createdAt], map: "admin_security_operations_actor_created_idx")
  @@index([ownershipTransferId, createdAt], map: "admin_security_operations_transfer_created_idx")
  @@map("admin_security_operations")
}

model OwnershipTransfer {
  id                   String                   @id @default(cuid())
  initiatedOperationId String                   @unique @map("initiated_operation_id") @db.Uuid
  ownerUserId          String                   @map("owner_user_id")
  targetUserId         String                   @map("target_user_id")
  ownerVersion         Int                      @map("owner_version")
  targetVersion        Int                      @map("target_version")
  status               OwnershipTransferStatus  @default(pending)
  pendingKey           String?                  @unique @default("ownership") @map("pending_key") @db.VarChar(32)
  expiresAt            DateTime                 @map("expires_at")
  initiatedAt          DateTime                 @default(now()) @map("initiated_at")
  resolvedAt           DateTime?                @map("resolved_at")
  owner                User                     @relation("OwnershipTransferOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  target               User                     @relation("OwnershipTransferTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  operations           AdminSecurityOperation[]

  @@index([status, expiresAt], map: "ownership_transfers_status_expires_idx")
  @@index([ownerUserId, initiatedAt], map: "ownership_transfers_owner_created_idx")
  @@index([targetUserId, initiatedAt], map: "ownership_transfers_target_created_idx")
  @@map("ownership_transfers")
}

model AdminProfileMutation {
  id                String                   @id @default(cuid())
  operationId       String                   @unique @map("operation_id") @db.Uuid
  kind              AdminProfileMutationKind
  targetUserId      String?                  @map("target_user_id")
  initiatedByUserId String?                  @map("initiated_by_user_id")
  fromRole          AppRole                  @map("from_role")
  fromAdminProfile  AdminProfile?            @map("from_admin_profile")
  toRole            AppRole                  @map("to_role")
  toAdminProfile    AdminProfile?            @map("to_admin_profile")
  targetVersion     Int                      @map("target_version")
  revokedSessions   Int                      @default(0) @map("revoked_sessions")
  createdAt         DateTime                 @default(now()) @map("created_at")
  target            User?                    @relation("AdminProfileMutationTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  initiatedBy       User?                    @relation("AdminProfileMutationInitiator", fields: [initiatedByUserId], references: [id], onDelete: SetNull)

  @@index([targetUserId, createdAt], map: "admin_profile_mutations_target_created_idx")
  @@index([initiatedByUserId, createdAt], map: "admin_profile_mutations_initiator_created_idx")
  @@map("admin_profile_mutations")
}

model TemporaryCredentialIssuance {
  id                String                              @id @default(cuid())
  operationId       String                              @unique @map("operation_id") @db.Uuid
  targetUserId      String                              @map("target_user_id")
  initiatedByUserId String?                             @map("initiated_by_user_id")
  deliveredByUserId String?                             @map("delivered_by_user_id")
  version           Int
  purpose           TemporaryPasswordPurpose
  reason            TemporaryCredentialReason
  reasonNote        String?                             @map("reason_note") @db.VarChar(200)
  status            TemporaryCredentialIssuanceStatus   @default(prepared)
  preparedAt        DateTime                            @default(now()) @map("prepared_at")
  issuedAt          DateTime?                           @map("issued_at")
  expiresAt         DateTime?                           @map("expires_at")
  failedAt          DateTime?                           @map("failed_at")
  supersededAt      DateTime?                           @map("superseded_at")
  safeFailureCode   String?                             @map("safe_failure_code") @db.VarChar(64)
  deliveryChannel   TemporaryCredentialDeliveryChannel? @map("delivery_channel")
  deliveredAt       DateTime?                           @map("delivered_at")
  supersededById    String?                             @unique @map("superseded_by_id")
  target            User                                @relation("TemporaryCredentialTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  initiatedBy       User?                               @relation("TemporaryCredentialInitiator", fields: [initiatedByUserId], references: [id], onDelete: SetNull)
  deliveredBy       User?                               @relation("TemporaryCredentialDeliverer", fields: [deliveredByUserId], references: [id], onDelete: SetNull)
  supersededBy      TemporaryCredentialIssuance?        @relation("TemporaryCredentialSupersession", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes        TemporaryCredentialIssuance?        @relation("TemporaryCredentialSupersession")

  @@unique([targetUserId, version])
  @@index([targetUserId, status, version], map: "temporary_credential_issuances_target_user_id_status_version_id")
  @@index([initiatedByUserId, preparedAt], map: "temporary_credential_issuances_initiated_by_user_id_prepared_at")
  @@index([deliveredByUserId, deliveredAt], map: "temporary_credential_issuances_delivered_by_user_id_delivered_a")
  @@map("temporary_credential_issuances")
}

model Session {
  id             String   @id @default(cuid())
  expiresAt      DateTime @map("expires_at")
  token          String   @unique
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  userId         String   @map("user_id")
  impersonatedBy String?  @map("impersonated_by")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limit")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

model Workspace {
  id                  String               @id @default(cuid())
  ownerId             String               @unique @map("owner_id")
  lifecycle           WorkspaceLifecycle   @default(ACTIVE)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  creditInitializedAt DateTime?            @map("credit_initialized_at")
  owner               User                 @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  clients             Client[]
  serviceRequests     ServiceRequest[]
  conversations       Conversation[]
  processingRuns      ProcessingRun[]
  proposalRevisions   ProposalRevision[]
  recordPlans         RecordPlan[]
  operationReceipts   OperationReceipt[]
  creditEntries       CreditEntry[]
  creditReservations  CreditReservation[]
  assistantThreads    AssistantThread[]
  auditEvents         AuditEvent[]
  cleanupTasks        CleanupTask[]
  outboxEvents        OutboxEvent[]
  uploadGrants        UploadGrant[]
  providerInvocations ProviderInvocation[]

  @@unique([id, ownerId])
  @@map("workspaces")
}

model Client {
  id                  String             @id @default(cuid())
  workspaceId         String             @map("workspace_id")
  name                String
  email               String?            @db.VarChar(320)
  normalizedEmail     String?            @map("normalized_email") @db.VarChar(320)
  phone               String?            @db.VarChar(64)
  normalizedPhone     String?            @map("normalized_phone") @db.VarChar(64)
  company             String?
  address             String?
  notes               String?
  creationOperationId String             @unique @map("creation_operation_id")
  createdByUserId     String             @map("created_by_user_id")
  updatedByUserId     String             @map("updated_by_user_id")
  version             Int                @default(1)
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  workspace           Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  creationOperation   OperationReceipt   @relation("ClientCreationOperation", fields: [creationOperationId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  createdBy           User               @relation("ClientCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy           User               @relation("ClientUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  serviceRequests     ServiceRequest[]
  selectedByReceipts  OperationReceipt[] @relation("ReceiptSelectedClient")
  recordPlans         RecordPlan[]       @relation("RecordPlanSelectedClient")

  @@unique([id, workspaceId])
  @@unique([creationOperationId, workspaceId])
  @@index([workspaceId, normalizedEmail])
  @@index([workspaceId, normalizedPhone])
  @@index([workspaceId, createdAt])
  @@map("clients")
}

model ServiceRequest {
  id                   String               @id @default(cuid())
  workspaceId          String               @map("workspace_id")
  clientId             String               @map("client_id")
  title                String
  description          String
  serviceType          ServiceType          @map("service_type")
  priority             RequestPriority      @default(NORMAL)
  status               ServiceRequestStatus @default(PENDING)
  preferredSchedule    String?              @map("preferred_schedule")
  serviceAddress       String?              @map("service_address")
  nextSteps            String?              @map("next_steps")
  creationOperationId  String               @map("creation_operation_id")
  sourceProposalItemId String?              @map("source_proposal_item_id")
  createdByUserId      String               @map("created_by_user_id")
  updatedByUserId      String               @map("updated_by_user_id")
  version              Int                  @default(1)
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  workspace            Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  client               Client               @relation(fields: [clientId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  creationOperation    OperationReceipt     @relation("RequestCreationOperation", fields: [creationOperationId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  createdBy            User                 @relation("RequestCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy            User                 @relation("RequestUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)

  @@unique([id, workspaceId])
  @@index([workspaceId, clientId, createdAt])
  @@index([workspaceId, status])
  @@index([workspaceId, sourceProposalItemId])
  @@map("service_requests")
}

model Conversation {
  id                        String                       @id @default(cuid())
  workspaceId               String                       @map("workspace_id")
  sourceType                ConversationSourceType       @map("source_type")
  locale                    AppLocale
  status                    ConversationStatus           @default(DRAFT)
  currentRunId              String?                      @unique @map("current_run_id")
  currentProposalRevisionId String?                      @unique @map("current_proposal_revision_id")
  completedOperationId      String?                      @unique @map("completed_operation_id")
  correlationId             String                       @map("correlation_id")
  version                   Int                          @default(1)
  deletionState             DeletionState                @default(ACTIVE) @map("deletion_state")
  createdAt                 DateTime                     @default(now()) @map("created_at")
  updatedAt                 DateTime                     @updatedAt @map("updated_at")
  workspace                 Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  audioArtifact             AudioArtifact?
  uploadGrants              UploadGrant[]
  runs                      ProcessingRun[]              @relation("ConversationRuns")
  currentRun                ProcessingRun?               @relation("ConversationCurrentRun", fields: [currentRunId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  proposalRevisions         ProposalRevision[]           @relation("ConversationProposalRevisions")
  currentProposalRevision   ProposalRevision?            @relation("ConversationCurrentProposal", fields: [currentProposalRevisionId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
