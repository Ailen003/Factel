  aggregateType  String            @map("aggregate_type") @db.VarChar(128)
  aggregateId    String            @map("aggregate_id")
  payload        Json?
  status         OutboxStatus      @default(PENDING)
  attempts       Int               @default(0)
  correlationId  String            @map("correlation_id")
  idempotencyKey String            @unique @map("idempotency_key")
  availableAt    DateTime          @default(now()) @map("available_at")
  deliveredAt    DateTime?         @map("delivered_at")
  safeError      String?           @map("safe_error")
  createdAt      DateTime          @default(now()) @map("created_at")
  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  operation      OperationReceipt? @relation(fields: [operationId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@index([status, availableAt])
  @@index([workspaceId, aggregateType, aggregateId])
  @@index([correlationId])
  @@map("outbox_events")
}

model AssistantThread {
  id              String                       @id @default(cuid())
  workspaceId     String                       @map("workspace_id")
  ownerUserId     String                       @map("owner_user_id")
  title           String?
  createdAt       DateTime                     @default(now()) @map("created_at")
  updatedAt       DateTime                     @updatedAt @map("updated_at")
  workspace       Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  owner           User                         @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  messages        AssistantMessage[]
  resources       AssistantResourceReference[]
  toolInvocations ToolInvocation[]

  @@unique([id, workspaceId])
  @@index([workspaceId, ownerUserId, updatedAt])
  @@map("assistant_threads")
}

model AssistantMessage {
  id                  String                 @id @default(cuid())
  workspaceId         String                 @map("workspace_id")
  threadId            String                 @map("thread_id")
  authorUserId        String?                @map("author_user_id")
  role                AssistantMessageRole
  content             String?
  status              AssistantMessageStatus @default(PENDING)
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  thread              AssistantThread        @relation(fields: [threadId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  author              User?                  @relation("AssistantMessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  providerInvocations ProviderInvocation[]
  toolInvocations     ToolInvocation[]

  @@unique([id, workspaceId])
  @@index([workspaceId, threadId, createdAt])
  @@map("assistant_messages")
}

model AssistantResourceReference {
  id             String          @id @default(cuid())
  workspaceId    String          @map("workspace_id")
  threadId       String          @map("thread_id")
  conversationId String?         @map("conversation_id")
  resourceType   String          @map("resource_type") @db.VarChar(128)
  resourceId     String          @map("resource_id")
  createdAt      DateTime        @default(now()) @map("created_at")
  thread         AssistantThread @relation(fields: [threadId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  conversation   Conversation?   @relation(fields: [conversationId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@unique([threadId, resourceType, resourceId])
  @@index([workspaceId, conversationId])
  @@map("assistant_resource_references")
}

model ToolInvocation {
  id                 String               @id @default(cuid())
  workspaceId        String               @map("workspace_id")
  threadId           String               @map("thread_id")
  messageId          String               @map("message_id")
  toolCode           String               @map("tool_code") @db.VarChar(128)
  arguments          Json?
  result             Json?
  status             ToolInvocationStatus @default(PENDING)
  recordPlanId       String?              @map("record_plan_id")
  recordApprovalId   String?              @map("record_approval_id")
  operationReceiptId String?              @map("operation_receipt_id")
  correlationId      String               @map("correlation_id")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  thread             AssistantThread      @relation(fields: [threadId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  message            AssistantMessage     @relation(fields: [messageId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  recordPlan         RecordPlan?          @relation(fields: [recordPlanId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  recordApproval     RecordApproval?      @relation(fields: [recordApprovalId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  operationReceipt   OperationReceipt?    @relation(fields: [operationReceiptId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@index([workspaceId, threadId, createdAt])
  @@index([correlationId])
  @@map("tool_invocations")
}

model AuditEvent {
  id             String       @id @default(cuid())
  workspaceId    String?      @map("workspace_id")
  actorUserId    String?      @map("actor_user_id")
  targetUserId   String?      @map("target_user_id")
  resourceType   String       @map("resource_type") @db.VarChar(128)
  resourceId     String?      @map("resource_id")
  action         String       @db.VarChar(128)
  outcome        AuditOutcome
  declaredReason String?      @map("declared_reason")
  correlationId  String       @map("correlation_id")
  safeMetadata   Json?        @map("safe_metadata")
  createdAt      DateTime     @default(now()) @map("created_at")
  workspace      Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  actor          User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([correlationId])
  @@map("audit_events")
}

model CleanupTask {
  id                String            @id @default(cuid())
  workspaceId       String?           @map("workspace_id")
  resourceType      String            @map("resource_type") @db.VarChar(128)
  resourceId        String            @map("resource_id")
  storageKey        String?           @map("storage_key")
  providerReference String?           @map("provider_reference") @db.VarChar(191)
  deletionIntent    String            @map("deletion_intent") @db.VarChar(128)
  status            CleanupTaskStatus @default(PENDING)
  attempts          Int               @default(0)
  requestedByUserId String?           @map("requested_by_user_id")
  correlationId     String            @map("correlation_id")
  safeError         String?           @map("safe_error")
  availableAt       DateTime          @default(now()) @map("available_at")
  completedAt       DateTime?         @map("completed_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  workspace         Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  requestedBy       User?             @relation("CleanupRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)

  @@unique([resourceType, resourceId, deletionIntent])
  @@index([status, availableAt])
  @@index([workspaceId, createdAt])
  @@index([correlationId])
  @@map("cleanup_tasks")
}

model TaskProfile {
  id            String       @id @default(cuid())
  capability    String       @db.VarChar(128)
  version       String       @db.VarChar(128)
  providerAlias String       @map("provider_alias") @db.VarChar(128)
  modelAlias    String?      @map("model_alias") @db.VarChar(128)
  schemaVersion String?      @map("schema_version")
  promptVersion String?      @map("prompt_version")
  policyVersion String?      @map("policy_version")
  runtimeLimits Json         @map("runtime_limits")
  status        PolicyStatus @default(ACTIVE)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@unique([capability, version])
  @@index([capability, status])
  @@map("task_profiles")
}

model PlatformPolicy {
  id             String       @id @default(cuid())
  policyKey      String       @unique @map("policy_key") @db.VarChar(128)
  version        String       @db.VarChar(128)
  status         PolicyStatus @default(ACTIVE)
  featureEnabled Boolean      @default(true) @map("feature_enabled")
  circuitState   CircuitState @default(CLOSED) @map("circuit_state")
  runtimeLimits  Json?        @map("runtime_limits")
  configuration  Json?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([policyKey, version])
  @@index([status, featureEnabled])
  @@map("platform_policies")
}

model PlatformSettings {
  id                    String   @id @default("public-access") @db.VarChar(32)
  accessContactEmail    String   @map("access_contact_email") @db.VarChar(320)
  accessRequestsEnabled Boolean  @default(false) @map("access_requests_enabled")
  version               Int      @default(0)
  updatedByUserId       String?  @map("updated_by_user_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  updatedBy             User?    @relation("PlatformSettingsUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
  @@map("platform_settings")
}
