# Canonical public origin used to resolve metadata and social-preview URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth server configuration. Generate a strong random secret locally and
# never commit its real value. Trusted origins are comma-separated exact origins.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# PostgreSQL / Prisma. Copy this file to .env and replace the sample safely.
# Encode reserved characters in credentials. This is server-only; never prefix it
# with NEXT_PUBLIC_.
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/talkflow?schema=public

# Optional local authentication fixtures for `pnpm db:seed`. These passwords
# are intentionally not committed; use separate values for local testing.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Example Platform Administrator
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
SEED_USER_COUNT=3
SEED_USER_EMAIL_DOMAIN=example.com
SEED_CLIENT_COUNT=3
SEED_REQUESTS_PER_CLIENT=2
SEED_DRY_RUN=false
# Set only for an intentional non-local fixture deployment.
SEED_ALLOW_PRODUCTION=false

# ─── Storage (Supabase – dev) ────────────────────────────────────────────────
# S3-compatible object storage. For Supabase, use the S3 endpoint and access
# keys from Project Settings > Storage. Keep these values server-only.
STORAGE_PROVIDER=supabase
# Use the exact region shown by the provider (use "local" for local Supabase).
STORAGE_REGION=us-east-1
# Example: https://<project-ref>.storage.supabase.co/storage/v1/s3
STORAGE_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
STORAGE_BUCKET=private-media
STORAGE_ACCESS_KEY=replace-with-s3-access-key
STORAGE_SECRET_KEY=replace-with-s3-secret-key
# Optional. Set only for intentionally public non-conversation assets. Private
# conversation audio is streamed through an authenticated application route.
STORAGE_PUBLIC_URL=

# Private conversation-audio policy. Values are server-only integer limits.
CONVERSATION_AUDIO_MAX_BYTES=26214400
CONVERSATION_AUDIO_MAX_DURATION_MS=600000
CONVERSATION_UPLOAD_GRANT_SECONDS=900

# Bearer secret sent by the scheduler to the private cleanup endpoint.
CRON_SECRET=replace-with-a-strong-random-secret

# Durable conversation transcription. Keep the provider key server-only.
CONVERSATION_SPEECH_ENABLED=false
ASSEMBLYAI_API_KEY=
# Optional regional/custom AssemblyAI API origin; must use HTTPS.
ASSEMBLYAI_BASE_URL=

# Closed AI extraction. Every new processing now requires this profile too.
CONVERSATION_EXTRACTION_ENABLED=false
GROQ_API_KEY=
# Model is pinned in the versioned server profile to openai/gpt-oss-120b.
# Inputs exceeding the limit fail without silent transcript truncation.
CONVERSATION_EXTRACTION_MAX_INPUT_CHARACTERS=80000
CONVERSATION_EXTRACTION_MAX_OUTPUT_TOKENS=16000
CONVERSATION_EXTRACTION_TIMEOUT_MS=90000
CONVERSATION_EXTRACTION_MAX_ATTEMPTS=2
