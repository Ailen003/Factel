{
  "name": "conversation-processing-demo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "postinstall": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && eslint .agent/reference/widget --no-ignore",
    "lint:fast": "eslint . --cache --cache-location .cache/eslint-app && eslint .agent/reference/widget --no-ignore --cache --cache-location .cache/eslint-reference",
    "validate:harness": "node --test scripts/harness-validation.test.mjs scripts/run-verification.test.mjs && node scripts/validate-harness.mjs",
    "test:unit": "vitest",
    "test:unit:run": "vitest run",
    "typecheck:app": "tsc --noEmit --incremental false",
    "typecheck:fast": "tsc --noEmit --incremental",
    "typecheck:reference": "tsc --project tsconfig.reference.json --noEmit --incremental false",
    "typecheck": "pnpm typecheck:app && pnpm typecheck:reference",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:resolve": "prisma migrate resolve",
    "db:migrate:reset": "prisma migrate reset",
    "db:migrate:diff": "prisma migrate diff",
    "db:seed": "prisma db seed",
    "db:initialize-credits": "node --import ./scripts/register-seed-loader.mjs scripts/initialize-workspace-credits.ts",
    "auth:bootstrap-owner": "node --import ./scripts/register-seed-loader.mjs scripts/bootstrap-owner.mjs",
    "auth:recover-owner-mfa": "node --import ./scripts/register-seed-loader.mjs scripts/recover-owner-mfa.mjs",
    "asterisk:ami": "node --env-file=.env.local scripts/asterisk/ami-listener.mjs",
    "test:asterisk": "node --test scripts/asterisk/ami-protocol.test.mjs",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "verify:fast": "pnpm test:unit:run && pnpm typecheck:fast && pnpm lint:fast",
    "verify": "node scripts/run-verification.mjs"
  },
